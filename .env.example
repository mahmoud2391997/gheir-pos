## POS → Website inventory sync
# The website base URL that hosts the shared inventory endpoints.
# Example (prod): https://gheir.vercel.app
# Example (dev):  http://localhost:5173
VITE_WEBSITE_API_BASE_URL="https://gheir.vercel.app"

# Must match the website's POS_API_KEY and will be sent as header `x-pos-key`.
VITE_POS_API_KEY="replace-with-same-secret-as-website"

# Optional: stable identifier for this register/device (used for troubleshooting).
VITE_POS_DEVICE_ID="register-01"
