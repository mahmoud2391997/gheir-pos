## Core server config (Express + tRPC)
#
# Required in production:
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/gheir_pos"
JWT_SECRET="replace-with-a-long-random-secret"
COOKIE_SAMESITE="lax"
PORT="3000"

# Demo mode (for previews only)
# - Enables a built-in demo login without a database.
# - DO NOT enable in real production.
# - Demo credentials: admin / AdminPass123!  (also accepts demo/demo)
# - Real accounts still sign in when DATABASE_URL is set.
DEMO_MODE="0"

# No POS register is attached to this deployment (web/preview).
# Shows a "Demo login" button and accepts the same demo credentials.
# Normal username/password login still works when DATABASE_URL is set.
# Do not enable this on a live store register.
NO_DEVICE="0"

# Optional (only if you still use Manus OAuth in your deployment):
VITE_APP_ID=""
OAUTH_SERVER_URL=""
VITE_OAUTH_PORTAL_URL=""
OWNER_OPEN_ID=""

## Website inventory sync
#
# --- Browser / web POS (Vite) ---
# These are embedded in the web bundle. Prefer Electron for store registers.
VITE_WEBSITE_API_BASE_URL="https://gheir.vercel.app"
VITE_POS_API_KEY="replace-with-same-secret-as-website"
VITE_POS_DEVICE_ID="register-01"

# --- Electron desktop POS (main process only; never exposed to renderer) ---
# Prefer these non-VITE names. They are read by electron/main via process.env
# and can also be persisted with Electron safeStorage under userData.
WEBSITE_API_BASE_URL="https://gheir.vercel.app"
POS_API_KEY="replace-with-same-secret-as-website"
POS_DEVICE_ID="register-01"
