## Website inventory sync
#
# --- Browser / web POS (Vite) ---
# These are embedded in the web bundle. Prefer Electron for store registers.
VITE_WEBSITE_API_BASE_URL="https://gheir.vercel.app"
VITE_POS_API_KEY="replace-with-same-secret-as-website"
VITE_POS_DEVICE_ID="register-01"

# --- Electron desktop POS (main process only; never exposed to renderer) ---
# Prefer these non-VITE names. They are read by electron/main via process.env
# and can also be persisted with Electron safeStorage under userData.
WEBSITE_API_BASE_URL="https://gheir.vercel.app"
POS_API_KEY="replace-with-same-secret-as-website"
POS_DEVICE_ID="register-01"
